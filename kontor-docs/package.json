{
  "name": "kontor-docs",
  "private": true,
  "version": "1.0.0",
  "description": "Free word processor",
  "author": {
    "name": "Kontor contributors",
    "email": "kontor@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:dist": "tsc --noEmit && vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.13.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^30.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.kontor.docs",
    "productName": "Kontor Docs",
    "copyright": "Copyright © Kontor contributors",
    "artifactName": "Kontor-Docs-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "role": "Editor",
        "ext": [
          "docx"
        ],
        "name": "DOCX Document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "role": "Editor",
        "ext": [
          "odt"
        ],
        "name": "OpenDocument Text",
        "mimeType": "application/vnd.oasis.opendocument.text"
      },
      {
        "role": "Viewer",
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Kontor-Docs-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kontor-Docs-Setup-windows-x64.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "Free word processor"
    },
    "appImage": {
      "artifactName": "Kontor-Docs-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Kontor-Docs-linux-x64.${ext}"
    }
  }
}
