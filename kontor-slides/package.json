{
  "name": "kontor-slides",
  "private": true,
  "version": "1.0.0",
  "description": "Free presentation program",
  "author": {
    "name": "Kontor contributors",
    "email": "kontor@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Emindev04/kontor",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "desktop:dist": "tsc --noEmit && vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12",
    "gifenc": "^1.0.3",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "io.github.kontor.slides",
    "productName": "Kontor Slides",
    "copyright": "Copyright © Kontor contributors",
    "artifactName": "Kontor-Slides-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "role": "Editor",
        "ext": [
          "pptx"
        ],
        "name": "PPTX Presentation",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      },
      {
        "role": "Viewer",
        "ext": [
          "ppsx"
        ],
        "name": "PPSX Slide Show",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.slideshow"
      },
      {
        "role": "Editor",
        "ext": [
          "potx"
        ],
        "name": "POTX Template",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.template"
      },
      {
        "role": "Editor",
        "ext": [
          "odp"
        ],
        "name": "OpenDocument Presentation",
        "mimeType": "application/vnd.oasis.opendocument.presentation"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "pkg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Kontor-Slides-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kontor-Slides-Setup-windows-x64.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "Free presentation program"
    },
    "appImage": {
      "artifactName": "Kontor-Slides-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Kontor-Slides-linux-x64.${ext}"
    },
    "msi": {
      "artifactName": "Kontor-Slides-windows-x64.msi",
      "perMachine": true,
      "oneClick": false
    },
    "pkg": {
      "artifactName": "Kontor-Slides-mac-${arch}.pkg",
      "identity": null,
      "installLocation": "/Applications"
    }
  }
}
